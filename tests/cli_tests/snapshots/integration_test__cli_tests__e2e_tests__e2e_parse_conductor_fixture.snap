      "body": "{\n  \"name\": \"conductor\",\n  \"version\": \"0.4.1\",\n  \"contextFileName\": \"GEMINI.md\",\n  \"plan\": {\n    \"directory\": \"conductor\"\n  }\n}\n",
      "kind": "rule",
